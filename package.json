{
	"name": "your-ui-is-not-my-ui",
	"private": true,
	"version": "1.0.0",
	"description": "Your UI is not my UI — a scrolling talk by Simon Lenz & Matthew Seccafien",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"build": "npm run check && vite build",
		"preview": "vite preview",
		"check": "node scripts/check-system.mjs",
		"personas": "node scripts/normalize-personas.mjs",
		"personas:watch": "node --watch-path=scripts --watch-path=css --watch-path=index.html --watch-path=media/personas/originals scripts/normalize-personas.mjs"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.12.0",
			"onFail": "error"
		}
	},
	"dependencies": {
		"gsap": "^3.15.0"
	},
	"devDependencies": {
		"vite": "^8.0.16"
	}
}
